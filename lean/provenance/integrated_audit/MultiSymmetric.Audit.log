              lo k * ADComplete.Rigidity.pairing u u ≤ ADComplete.Rigidity.pairing u ((B k).mulVec u) ∧
                ADComplete.Rigidity.pairing u ((B k).mulVec u) ≤ hi k * ADComplete.Rigidity.pairing u u) →
            ∀ (V : Submodule MultiSymmetric.Rigidity.RF (ι → MultiSymmetric.Rigidity.RF)),
              ↑(Module.finrank MultiSymmetric.Rigidity.RF ↥V) * ∑ k, (hi k - lo k) < 1 →
                (∀ x ∈ V,
                    ADComplete.DifferentialKrylov.connection ADComplete.RationalDerivative.derivative
                        (MultiSymmetric.Rigidity.rationalConnection a B H) x ∈
                      V) →
                  ∃ R s₀, R.submatrix s₀ id = 1 ∧ V = (R.map ⇑(algebraMap ℝ MultiSymmetric.Rigidity.RF)).mulVecLin.range
@MultiSymmetric.Krylov.polynomialVector_rationalKrylov : ∀ {τ : Type u_1} {ι : Type u_2} [inst : Fintype τ]
  [inst_1 : Fintype ι] (a : τ → ℝ) (κ : ℝ),
  κ ≠ 0 →
    ∀ (H : Matrix ι ι ℝ) (A : τ → Matrix ι ι ℝ) (v : ι → ℝ) (k : ℕ),
      (fun i =>
          (algebraMap (Polynomial ℝ) MultiSymmetric.Krylov.RF) (MultiSymmetric.Krylov.polynomialVector a κ H A v k i)) =
        ((algebraMap ℝ MultiSymmetric.Krylov.RF) κ *
              (algebraMap (Polynomial ℝ) MultiSymmetric.Krylov.RF) (MultiSymmetric.Rigidity.denom a)) ^
            k •
          MultiSymmetric.Krylov.rationalKrylov a κ H A v k
@MultiSymmetric.Spanning.rank_sensitive_spanning : ∀ {τ : Type u_1} {ι : Type u_2} [inst : Fintype τ] [Nonempty τ]
  [inst_2 : Fintype ι] (a : τ → ℝ),
  Function.Injective a →
    ∀ (κ : ℝ),
      κ ≠ 0 →
        ∀ (H : Matrix ι ι ℝ),
          H.IsSymm →
            ∀ (A : τ → Matrix ι ι ℝ) (v : ι → ℝ) (lo hi : τ → ℝ),
              (∀ (b : τ) (u : ι → ℝ),
                  lo b * ADComplete.Rigidity.pairing u u ≤ ADComplete.Rigidity.pairing u ((κ⁻¹ • A b).mulVec u) ∧
                    ADComplete.Rigidity.pairing u ((κ⁻¹ • A b).mulVec u) ≤ hi b * ADComplete.Rigidity.pairing u u) →
                ↑(Fintype.card ι) * ∑ b, (hi b - lo b) < 1 →
                  have r := Module.finrank ℝ ↥(MultiSymmetric.Cyclic.jointModule H A v);
                  Submodule.span ℝ
                        {z |
                          ∃ k < r,
                            ∃ j ≤ Fintype.card τ * k, z = MultiSymmetric.Spanning.coefficientVector a κ H A v k j} =
                      MultiSymmetric.Cyclic.jointModule H A v ∧
                    (LinearIndependent MultiSymmetric.Spanning.RF fun j =>
                        MultiSymmetric.Krylov.rationalKrylov a κ H A v ↑j) ∧
                      ∀ (k : ℕ),
                        MultiSymmetric.Krylov.rationalKrylov a κ H A v k ∈
                          ADComplete.DifferentialKrylov.krylovSpan (MultiSymmetric.Krylov.rationalKrylov a κ H A v) r
@MultiSymmetric.Public.spectral_rank_prefix : ∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι]
  [inst_2 : Nonempty ι] (s N : ℕ),
  1 ≤ s →
    1 ≤ N →
      Fintype.card ι ≤ N →
        ∀ (H : Matrix ι ι ℝ),
          H.IsSymm →
            ∀ (A : Fin s → Matrix ι ι ℝ) (hA : ∀ (b : Fin s), (A b).IsSymm) (v : ι → ℝ),
              (∀ (b : Fin s),
                  ADComplete.SpectralBands.eigenMax (A b) ⋯ - ADComplete.SpectralBands.eigenMin (A b) ⋯ ≤ ↑N - 1) →
                have r := Module.finrank ℝ ↥(MultiSymmetric.Cyclic.jointModule H A v);
                Submodule.span ℝ {z | ∃ k < r, ∃ j ≤ s * k, z = MultiSymmetric.Public.response s N H A v k j} =
                  MultiSymmetric.Cyclic.jointModule H A v
@MultiSymmetric.Public.spectral_full_family : ∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι]
  [inst_2 : Nonempty ι] (s N : ℕ),
  1 ≤ s →
    1 ≤ N →
      Fintype.card ι ≤ N →
        ∀ (H : Matrix ι ι ℝ),
          H.IsSymm →
            ∀ (A : Fin s → Matrix ι ι ℝ) (hA : ∀ (b : Fin s), (A b).IsSymm) (v : ι → ℝ),
              (∀ (b : Fin s),
                  ADComplete.SpectralBands.eigenMax (A b) ⋯ - ADComplete.SpectralBands.eigenMin (A b) ⋯ ≤ ↑N - 1) →
                Submodule.span ℝ {z | ∃ k < N, ∃ j ≤ s * k, z = MultiSymmetric.Public.response s N H A v k j} =
                  MultiSymmetric.Cyclic.jointModule H A v
MultiSymmetric.Recurrence.index_card : ∀ (s N : ℕ),
  Fintype.card (MultiSymmetric.Recurrence.Index s N) = N + s * N * (N - 1) / 2
MultiSymmetric.Recurrence.probe_mem_wordSpan : ∀ (s N : ℕ) (i : MultiSymmetric.Recurrence.Index s N),
  MultiSymmetric.Recurrence.probe s N i ∈ MultiSymmetric.Recurrence.wordSpan s (N - 1)
@MultiSymmetric.Recurrence.universalRow_evaluate : ∀ {R : Type u_1} [inst : Ring R] [inst_1 : Algebra ℤ R] (s N k : ℕ)
  (Xv : Fin (s + 1) → R),
  Polynomial.map ((FreeAlgebra.lift ℤ) Xv).toRingHom (MultiSymmetric.Recurrence.universalRow s N k) =
    MultiSymmetric.Recurrence.row s (↑s * ↑N ^ 2) (Xv 0) (fun i => Xv i.succ) k
@MultiSymmetric.Recurrence.row_coeff_mulVec : ∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι] (s : ℕ)
  (κ : ℤ) (H : MultiSymmetric.Recurrence.Mat) (A : Fin s → MultiSymmetric.Recurrence.Mat) (v : ι → ℝ) (k j : ℕ) (i : ι),
  Matrix.mulVec ((MultiSymmetric.Recurrence.row s κ H A k).coeff j) v i =
    (MultiSymmetric.Krylov.polynomialVector (fun b => ↑↑b) (↑κ) H A v k i).coeff j
@MultiSymmetric.Recurrence.universal_probe_response : ∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι]
  (s N : ℕ) (H : MultiSymmetric.Recurrence.Mat) (A : Fin s → MultiSymmetric.Recurrence.Mat) (v : ι → ℝ)
  (idx : MultiSymmetric.Recurrence.Index s N),
  Matrix.mulVec (((FreeAlgebra.lift ℤ) fun i => Fin.cases H A i) (MultiSymmetric.Recurrence.probe s N idx)) v = fun i =>
    (MultiSymmetric.Krylov.polynomialVector (fun b => ↑↑b) (↑(↑s * ↑N ^ 2)) H A v (↑idx.fst) i).coeff ↑idx.snd
@MultiSymmetric.Recurrence.row_one_eq_original : ∀ {R : Type u_1} [inst : Ring R] (N k j : ℕ) (H K : R),
  (MultiSymmetric.Recurrence.row 1 (↑N ^ 2) H (fun x => K) k).coeff j =
    CircuitAudit.Degrees.Expr.eval H K (CircuitAudit.Degrees.probe N k j)
@MultiSymmetric.Circuit.complete_family_circuit : ∀ {R : Type u_1} [inst : Ring R] (s N : ℕ),
  0 < s →
    0 < N →
      ∀ (gen : Fin (s + 1) → R),
        have run := MultiSymmetric.Circuit.familyRun s (↑s * ↑N ^ 2) gen (N - 1);
        run.gates + (s + 1) ≤ s + 3 + 30 * (s + 1) ^ 2 * N ^ 2 ∧
          run.rows.length = N ∧
            (∀ (i : MultiSymmetric.Recurrence.Index s N),
                (run.rows.getD (N - 1 - ↑i.fst) 0).coeff ↑i.snd =
                  (MultiSymmetric.Recurrence.row s (↑s * ↑N ^ 2) (gen 0) (fun j => gen j.succ) ↑i.fst).coeff ↑i.snd) ∧
              ∀ c ∈ run.usedScalars, c.natAbs.size + 1 ≤ 3 + (s + 1).size + 3 * (N + 1).size
@MultiSymmetric.Circuit.familyRun_scalars_bound : ∀ {R : Type u_1} [inst : Ring R] (s N : ℕ) (gen : Fin (s + 1) → R),
  ∀ k < N,
    ∀ c ∈ (MultiSymmetric.Circuit.familyRun s (↑s * ↑N ^ 2) gen k).usedScalars,
      c.natAbs ≤ MultiSymmetric.Circuit.constantBudget s N
MultiSymmetric.Circuit.scalar_bit_bound : ∀ (s N : ℕ) (c : ℤ),
  c.natAbs ≤ MultiSymmetric.Circuit.constantBudget s N → c.natAbs.size + 1 ≤ 3 + (s + 1).size + 3 * (N + 1).size
